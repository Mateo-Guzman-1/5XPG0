# =============================================================================
# 5XPG0 — things that must NOT go into the student repository
# =============================================================================

# Internal documents (instructor-only)
instructions.md
detailed_instructions.md

# LaTeX: publish only the compiled PDFs, never the sources or the beamer style
*.tex
*.sty
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# LaTeX asset folders (not needed once only the PDFs are published)
PresentationInstruction/figures/
PresentationInstruction/resources/
ProjectPitch/figures/
ProjectPitch/resources/

# Python bytecode and caches (these patterns apply in every subfolder)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local Python environments and environment-specific configuration
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
pip-wheel-metadata/

# Python packaging/build output
build/
dist/
*.egg-info/
.eggs/
*.egg

# Project-generated datasets, models, and experiment output
runs/
data/
checkpoints/
*.pt
*.pth

# Build artifacts — keep the sources and the single released bitstream only
code/pynqz2_riscv_flow/firmware/*.o
code/pynqz2_riscv_flow/firmware/*.elf
code/pynqz2_riscv_flow/firmware/*.map
code/pynqz2_riscv_flow/vivado/rvproj/
code/pynqz2_riscv_flow/vivado/build-logs/
code/pynqz2_riscv_flow/vivado/.Xil/
code/pynqz2_riscv_flow/.board-ip

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~

# Windows/PowerShell temporary output
*.tmp
*.temp
*.stackdump

# Credentials and local SSH keys
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
code/pynqz2_riscv_flow/pynq
code/pynqz2_riscv_flow/pynq.pub
code/pynqz2_riscv_flow/y
code/pynqz2_riscv_flow/y.pub
