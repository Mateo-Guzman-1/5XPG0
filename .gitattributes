# Keep cross-platform source files predictable while allowing native checkout
# line endings for platform-specific scripts.
* text=auto
*.sh text eol=lf
Makefile text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.ld text eol=lf
*.tcl text eol=lf
*.xdc text eol=lf
*.npz binary
*.bin binary
*.bit binary
*.pdf binary
*.png binary
*.jpg binary
# Preserve tool-generated report formatting verbatim.
code/snn_keyword/results/*.rpt -whitespace
